# ===========================================
# Family Tree - Конфигурация окружения
# ===========================================
# Скопируйте этот файл в .env и заполните значениями
# cp .env.example .env

# ===========================================
# 🗄️ База данных (PostgreSQL)
# ===========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=family_tree_user
DB_PASSWORD=your_secure_password_here
DB_NAME=family_tree_db

# ===========================================
# 🔐 Аутентификация (JWT)
# ===========================================
# Секретный ключ для подписи JWT токенов
# Рекомендуется сгенерировать случайную строку:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Алгоритм шифрования JWT (не менять без необходимости)
ALGORITHM=HS256

# Срок действия access токена в днях
ACCESS_TOKEN_EXPIRE_DAYS=1

# ===========================================
# 🚀 Приложение (опционально)
# ===========================================
# ENV=development
# DEBUG=true
# LOG_LEVEL=INFO
