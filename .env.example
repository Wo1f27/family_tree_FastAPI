# ===========================================
# Family Tree - Docker Configuration
# ===========================================
# Копируй этот файл в .env и заполни значения

# ===========================================
# 🐘 PostgreSQL (нативно на сервере)
# ===========================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=familytree
DB_USER=familytree
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ===========================================
# 🌐 Приложение
# ===========================================
FAMILY_TREE_DB_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
FAMILY_TREE_HOST=0.0.0.0
FAMILY_TREE_PORT=8000
FAMILY_TREE_DEBUG=false
FAMILY_TREE_DEBUG_SQL=false

# ===========================================
# 🌐 Домен (для SSL)
# ===========================================
DOMAIN=your-domain.com
